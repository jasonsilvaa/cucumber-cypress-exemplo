{
  "name": "cucumber-cypress-exemplo",
  "version": "1.0.0",
  "description": "Exemplo de modelo com cypress e cucumber",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:headed": "cypress run --headed",
    "test:login": "cypress run --spec cypress/e2e/login.feature",
    "test:admin": "cypress run --spec cypress/e2e/admin-livros.feature",
    "test:hub": "cypress run --spec \"cypress/e2e/login.feature,cypress/e2e/admin-livros.feature\"",
    "test:external": "cypress run --spec cypress/e2e/teste.feature",
    "test:tags": "cypress run --env tags",
    "lint": "eslint cypress/",
    "lint:fix": "eslint cypress/ --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.6",
    "cypress": "^14.5.4",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.10",
    "eslint": "^8.50.0",
    "eslint-plugin-cypress": "^2.15.1"
  }
}
